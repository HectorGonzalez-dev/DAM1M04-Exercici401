<main>
    <h1 class="page-title">Editar cliente</h1>
    <form id="editClientForm" action="/editClient" method="POST" novalidate>
        <input type="hidden" name="id" value="{{client_id}}">
        <div class="form-group">
            <label for="clientName">Nombre *</label>
            <input type="text" id="clientName" name="name" required value="{{client_info.name}}">
            <div class="error-message" id="errorName" style="color:red;">
                {{#if errors.name}}{{errors.name}}{{/if}}
            </div>
        </div>
        <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required value="{{client_info.email}}">
            <div class="error-message" id="errorEmail" style="color:red;">
                {{#if errors.email}}{{errors.email}}{{/if}}
            </div>
        </div>
        <div class="form-group">
            <label for="phone">Phone *</label>
            <input type="tel" id="phone" name="phone" required value="{{client_info.phone}}">
            <div class="error-message" id="errorPhone" style="color:red;">
                {{#if errors.phone}}{{errors.phone}}{{/if}}
            </div>
        </div>
        <button type="submit" class="main-btn">Editar cliente</button>
        <button type="submit" formaction="/deleteClient" formmethod="POST"
                class="delete-btn">
            Eliminar cliente
        </button>
        <a href="/clients?page=1" class="cancel-btn">Cancelar</a>
    </form>
    <script src="/js/main.js"></script>
</main>
