<main>
    <h1 class="page-title">Agregar nuevo cliente</h1>
    <form id="addClientForm" action="/createClient" method="POST" novalidate>
        <div class="form-group">
            <label for="clientName">Nombre *</label>
            <input type="text" id="clientName" name="name" required>
            <div class="error-message" id="errorName" style="color:red;">
                {{#if errors.name}}{{errors.name}}{{/if}}
            </div>
        </div>
        <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required>
            <div class="error-message" id="errorEmail" style="color:red;">
                {{#if errors.email}}{{errors.email}}{{/if}}
            </div>
        </div>
        <div class="form-group">
            <label for="phone">Phone *</label>
            <input type="tel" id="phone" name="phone" required>
            <div class="error-message" id="errorPhone" style="color:red;">
                {{#if errors.phone}}{{errors.phone}}{{/if}}
            </div>
        </div>
        <button type="submit" class="main-btn">Agregar cliente</button>
        <a href="/clients?page=1" class="cancel-btn">Cancelar</a>
    </form>
    <script src="/js/main.js"></script>
</main>
